{
  "name": "patton",
  "productName": "Patton",
  "version": "1.0.0",
  "description": "A terminal emulator with a built-in text editor, split panes, and intelligent mode switching",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "npm audit --omit=dev --audit-level=high && electron-forge package",
    "install-app": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "release": "bash scripts/release.sh",
    "health": "bash scripts/patton-health.sh"
  },
  "keywords": ["terminal", "electron", "xterm", "codemirror", "split-panes"],
  "author": "Michael Young",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaeljryoung/patton.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-deb": "7.11.1",
    "@electron-forge/maker-dmg": "7.11.1",
    "@electron-forge/maker-rpm": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/maker-zip": "7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.1",
    "@electron-forge/plugin-fuses": "7.11.1",
    "@electron-forge/plugin-vite": "7.11.1",
    "@electron/fuses": "1.8.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "electron": "40.8.0",
    "eslint": "9.17.0",
    "eslint-plugin-import": "2.32.0",
    "typescript": "5.7.3",
    "vite": "5.4.21"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.1",
    "@codemirror/commands": "6.10.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.2",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.39.16",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "node-pty": "1.1.0"
  }
}
